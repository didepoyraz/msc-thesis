#version 450

layout(set = 0, binding = 0) buffer MatrixA {
   float dataA[];
};

layout(binding = 1) buffer MatrixB {
   float dataB[];
};

layout(binding = 2) buffer MatrixC {
   float output_dataC[];
};

//layout (local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
layout (local_size_x = 1, local_size_y = 1, local_size_z = 1) in; // each thread will calculate a 2x2 output

layout (constant_id = 0) const uint MATRIX_SIZE = 1024;
layout (constant_id = 1) const uint TILE_SIZE = 16; 
layout (constant_id = 3) const uint RESULTS_PER_THREAD = 4;

shared float tileA[TILE_SIZE][TILE_SIZE];
shared float tileB[TILE_SIZE][TILE_SIZE];

void main() {

    uvec2 gid = gl_GlobalInvocationID.xy;

    // each thread handles a 2x2 tile
    // compute the starting cell for this tile
    uint base_x = gid.x*2;
    uint base_y = gid.y*2;

    // loop over the 2x2 tile
    for (uint dy = 0; dy < RESULTS_PER_THREAD; ++dy) {
        for (uint dx = 0; dx < RESULTS_PER_THREAD; ++dx) {
            uint x = base_x + dx; // row
            uint y = base_y + dy; // col

            if (x >= MATRIX_SIZE || y >= MATRIX_SIZE) {
            return;
            }               
            // uint idx = base_x * 4 + base_y; // Row-major index
     
            for (uint i = 0; i < MATRIX_SIZE; i++) {
                output_dataC[x * MATRIX_SIZE + y] += (dataA[x * MATRIX_SIZE + i] * dataB[i * MATRIX_SIZE + y]);
            }
        }
    }
}