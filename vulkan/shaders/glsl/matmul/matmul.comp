//original version of shader
#version 450

layout(set = 0, binding = 0) buffer MatrixA {
   float dataA[];
};

layout(binding = 1) buffer MatrixB {
   float dataB[];
};

layout(binding = 2) buffer MatrixC {
   float output_dataC[];
};

//layout (local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
layout (local_size_x_id = 1, local_size_y_id = 2, local_size_z = 1) in;


void main() 
{	
    uint idx = gl_GlobalInvocationID.x;

    // read from the buffer to simulate matrix access
    float val = dataA[idx];

    // prevent compiler optimization by writing back the result
    dataA[idx] = val;
}
