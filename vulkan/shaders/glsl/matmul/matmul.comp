#version 450

layout(set = 0, binding = 0) buffer MatrixA {
   float dataA[];
};

layout(binding = 1) buffer MatrixB {
   float dataB[];
};

layout(binding = 2) buffer MatrixC {
   float output_dataC[];
};

layout (local_size_x_id = 1, local_size_y = 1, local_size_z = 1) in;

layout (constant_id = 0) const uint MATRIX_SIZE = 1024;
layout (constant_id = 2) const uint BLOCKSIZE = 16; 

void main() {
    // global position in the matrix
    uint wg_x = gl_WorkGroupID.x;
    uint wg_y = gl_WorkGroupID.y;

    uint local_id = gl_LocalInvocationID.x;

    uint local_x = local_id / BLOCKSIZE;
    uint local_y = local_id % BLOCKSIZE;

    uint x = wg_x * BLOCKSIZE + local_x;
    uint y = wg_y * BLOCKSIZE + local_y;


    float result = 0.0;
	for (uint i = 0; i < MATRIX_SIZE; i++) {
		result += (dataA[x * MATRIX_SIZE + i] * dataB[i * MATRIX_SIZE + y]); 
	}

    output_dataC[x * MATRIX_SIZE + y] = result;
}
