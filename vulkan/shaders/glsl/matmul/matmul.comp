#version 450

layout(std430, set=0, binding=0) buffer MatrixA  { vec4 A4[];  }; 
layout(std430, set=0, binding=1) buffer MatrixBT { vec4 BT4[]; }; 
layout(std430, set=0, binding=2) buffer MatrixC  { float C[];   }; 

layout(local_size_x = 16, local_size_y = 4, local_size_z = 1) in;

layout(constant_id = 0) const uint M = 1024u;
layout(constant_id = 1) const uint TILE = 16u;      

const uint K = M;
const uint N = M;
const uint lda4 = K / 4u;  
const uint lbt4 = K / 4u;  
const uint ldc  = N;    

shared vec4 sA[TILE][TILE/4];   
shared vec4 sBT[TILE][TILE/4];  

void main() {
    uint lx = gl_LocalInvocationID.x; // 0..15 (col within tile)
    uint ly = gl_LocalInvocationID.y; // 0..3  (row block of 4 within tile)

    uint wgX = gl_WorkGroupID.x;      // tile column
    uint wgY = gl_WorkGroupID.y;      // tile row

    // This WG computes C tile: rows [wgY*16 .. wgY*16+15], cols [wgX*16 .. wgX*16+15]
    uint col = wgX*TILE + lx;               // one column per thread
    uint row0 = wgY*TILE + (ly<<2);         // base row for this thread's 4 rows

    if (col >= N || row0 >= M) return;    

    float acc0 = 0.0, acc1 = 0.0, acc2 = 0.0, acc3 = 0.0;

    for (uint k0 = 0u; k0 < K; k0 += TILE) {
        // ---- cooperative loads into shared memory ----
        // Fill sA: 16 rows × 4 k4
        uint aRow = wgY*TILE + lx;                  // 0..15 across the warp-x
        uint aK4  = (k0 >> 2) + ly;                 // 0..3 across the warp-y
        sA[lx][ly] = A4[aRow * lda4 + aK4];

        // Fill sBT: 16 cols × 4 k4 (BT row index == C column)
        uint btCol = wgX*TILE + lx;                 // 0..15 across warp-x
        uint btK4  = (k0 >> 2) + ly;                // 0..3 across warp-y
        sBT[lx][ly] = BT4[btCol * lbt4 + btK4];

        barrier(); 

        // ---- MAC: 4 rows × 1 col per thread ----
        for (uint t = 0u; t < TILE/4; ++t) {
            vec4 b  = sBT[lx][t];             // B[k..k+3, col]
            acc0   += dot(sA[(ly<<2)+0][t], b);
            acc1   += dot(sA[(ly<<2)+1][t], b);
            acc2   += dot(sA[(ly<<2)+2][t], b);
            acc3   += dot(sA[(ly<<2)+3][t], b);
        }

        barrier(); 
    }

    // ---- stores (with row guards for edge tiles) ----
    if (row0+0u < M) C[(row0+0u)*ldc + col] = acc0;
    if (row0+1u < M) C[(row0+1u)*ldc + col] = acc1;
    if (row0+2u < M) C[(row0+2u)*ldc + col] = acc2;
    if (row0+3u < M) C[(row0+3u)*ldc + col] = acc3;
}
