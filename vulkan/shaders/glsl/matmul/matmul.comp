#version 450

layout(std430, set = 0, binding = 0) buffer MatrixA {
   vec4 dataA4[];
};

layout(std430,binding = 1) buffer MatrixB {
   vec4 dataB4[];
};

layout(std430,binding = 2) buffer MatrixC {
   float output_dataC[];
};

layout(push_constant) uniform PushConstants {
    uint offsetRowA;
    uint offsetColA;
    uint offsetRowB;
    uint offsetColB;
    uint offsetRowC;
    uint offsetColC;
} pc;

//layout (local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
layout (local_size_x= 16, local_size_y = 4, local_size_z = 1) in;

layout (constant_id = 0) const uint MATRIX_SIZE = 1024;
layout (constant_id = 1) const uint TILE_SIZE = 16; 
layout (constant_id = 2) const uint leadingDimensionN = 4096; 

shared vec4 tileA[TILE_SIZE][TILE_SIZE / 4];
shared vec4 tileB[TILE_SIZE/4][TILE_SIZE];

void main() {
    // // global position in the matrix
    uint row = pc.offsetRowA + gl_GlobalInvocationID.y;
    uint col = pc.offsetColB + gl_GlobalInvocationID.x; 


    // local position within the workgroup
    uint localRow = gl_LocalInvocationID.y;
    uint localCol = gl_LocalInvocationID.x;

    // uint vec4Col = localCol / 4;
    // uint vec4Row = localRow / 4;
    // i guess because the threads are now spawned in a vec4 way you don't really need to divide it by four?
    uint vec4Col =  gl_LocalInvocationID.y;
    uint vec4Row = gl_LocalInvocationID.x;
    // Bounds check
    if (row >= leadingDimensionN || col >= leadingDimensionN) {
        return;
    }

    float result = 0;

    // Loop over tiles horizontally and k increases by TILE_SIZE so that each thread only accesses it's own relative position within different tiles
    for (uint k = 0; k < MATRIX_SIZE; k += TILE_SIZE) {

        tileA[vec4Row][vec4Col] = dataA4[row*(leadingDimensionN/4) + ((pc.offsetColA >> 2) + (k>>2) + localCol)];
        // dataA4[row * leadingDimensionN + (pc.offsetColA + k + localCol + 0)],
   
        tileB[vec4Col][vec4Row] = dataB4[(((pc.offsetRowB >>2) + (k>>2) + localRow)) * (leadingDimensionN/4) + col],
        // dataB[(pc.offsetRowB + k + localRow + 0) * leadingDimensionN + col]

        // Synchronize all threads in the workgroup for the tile to be completed
        barrier();

        // Compute partial dot product for this tile
        // for (uint t = 0; t < TILE_SIZE; t++) {
        //     result += tileA[localRow][t] * tileB[t][localCol];
        // }

        for (uint t = 0; t < TILE_SIZE / 4; t++) {
        // result += dot(tileA[...], tileB[...])
            vec4 a = tileA[localRow][t];     
            // think about this
            vec4 b = tileB[t][localCol];  
            result += dot(a, b);
        }

        // Wait for all threads before loading the next tile
        barrier();
    }

    uint outputRow = pc.offsetRowC + gl_GlobalInvocationID.y;
    uint outputCol = pc.offsetColC + gl_GlobalInvocationID.x;

    // Store the full result in the output matrix, each thread saves its own respective result
     if (outputRow < leadingDimensionN && outputCol < leadingDimensionN) {
        
        // if the resulting matrix is being accumulated in a shared buffer 
        // outside of vulan do "=" if there is no shared buffer outside of 
        // vulkan and the program is calculating partial dot products in 
        // seperate command buffer do "+="
        
        output_dataC[outputRow * leadingDimensionN + outputCol] = result;
    }

}